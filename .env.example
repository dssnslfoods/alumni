# ==========================================================================
# ระบบหนังสืออนุสรณ์ สภจ. 2569 — ตัวอย่างการตั้งค่าสำหรับพัฒนาบนเครื่อง
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามการใช้งานจริง (ห้าม commit ไฟล์ .env)
# ==========================================================================

# --------------------------- Secrets (บังคับบน production) ---------------------------
# ใช้ลงลายเซ็น session token ของผู้ใช้ — สร้างด้วย: openssl rand -hex 32
AUTH_JWT_SECRET=

# ใช้เป็น pepper ในการเข้ารหัสเลขท้ายบัตรประชาชนแบบทางเดียว — สร้างด้วย: openssl rand -hex 32
# คำเตือน: หากเปลี่ยนค่านี้ ข้อมูลยืนยันตัวตนเดิมทั้งหมดจะใช้ไม่ได้ ต้องนำเข้า Excel ใหม่
ID_HASH_SECRET=

# คีย์กู้คืนบัญชีเจ้าของระบบกรณีลืมรหัสผ่าน (ไม่ตั้งค่า = ปิดฟีเจอร์นี้)
ADMIN_ACCESS_KEY=

# ในโหมดพัฒนา หากเว้นว่างทั้ง AUTH_JWT_SECRET และ ID_HASH_SECRET
# ระบบจะสุ่มค่าให้อัตโนมัติและเก็บไว้ที่ data/.dev-secrets.json

# ------------------------------ บัญชีเจ้าของระบบ ------------------------------
# บัญชีตั้งต้นที่ระบบสร้างให้อัตโนมัติเมื่อเริ่มทำงานครั้งแรก
# ใช้บัญชีนี้เข้าไปสร้าง admin, ตัวแทนรุ่น และบัญชีนิสิตเก่าต่อไป
OWNER_USERNAME=arpaket
OWNER_DISPLAY_NAME=เจ้าของระบบ
OWNER_EMAIL=arpaket@gmail.com

# รหัสผ่านเริ่มต้นของ owner — เว้นว่างเพื่อให้ระบบสุ่มและพิมพ์ออกทาง log ครั้งเดียว
# ไม่ว่ากรณีใด ระบบจะบังคับให้เปลี่ยนรหัสผ่านเมื่อเข้าสู่ระบบครั้งแรกเสมอ
OWNER_INITIAL_PASSWORD=

# --------------------------------- Firebase ---------------------------------
# true เมื่อต้องการใช้ Firestore/Storage จริง (บน Cloud Functions จะเปิดอัตโนมัติ)
FIREBASE_ENABLED=false

# path แบบ absolute ของ service account JSON ที่ดาวน์โหลดจาก Firebase Console
GOOGLE_APPLICATION_CREDENTIALS=

FIREBASE_STORAGE_BUCKET=alumni-13428.firebasestorage.app
FIREBASE_STORAGE_FOLDER=yearbook-photos

# ชื่อ collection (ปกติไม่ต้องแก้)
FIREBASE_USERS_COLLECTION=users
FIREBASE_USERNAMES_COLLECTION=usernames
FIREBASE_ALUMNI_COLLECTION=alumni
FIREBASE_SUBMISSIONS_COLLECTION=alumniSubmissions
FIREBASE_IMPORT_JOBS_COLLECTION=importJobs
FIREBASE_AUDIT_COLLECTION=auditLogs
FIREBASE_SETTINGS_COLLECTION=settings

# --------------------------------- นโยบายระบบ ---------------------------------
AUTH_SESSION_HOURS=8
AUTH_MAX_LOGIN_FAILURES=8
AUTH_LOCKOUT_MINUTES=15
AUTH_MIN_PASSWORD_LENGTH=10
YEARBOOK_MAX_BATCH=88
PDPA_VERSION=yearbook-2569-v1
MAX_UPLOAD_BYTES=10485760

# พอร์ตของ API ตอนพัฒนาบนเครื่อง (ตั้งใจไม่ใช้ชื่อ PORT เพื่อไม่ให้ชนกับ Vite)
API_PORT=3001
